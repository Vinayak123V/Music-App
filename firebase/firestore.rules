rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Admins collection: Only existing admins can read/write admin list
    match /admins/{adminId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Songs collection
    // Public can only read published songs; admins have full access
    match /songs/{songId} {
      allow read: if resource.data.published == true || isAdmin();
      allow create: if isAdmin() &&
                    request.resource.data.title is string &&
                    request.resource.data.artist is string &&
                    request.resource.data.storagePath is string &&
                    request.resource.data.categoryId is string &&
                    request.resource.data.deityId is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Categories collection
    // Public can read enabled categories; admins have full control
    match /categories/{categoryId} {
      allow read: if resource.data.enabled == true || isAdmin();
      allow write: if isAdmin();
    }

    // Deities collection
    match /deities/{deityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin curated Playlists
    match /playlists/{playlistId} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if isAdmin();
    }

    // User profile and private subcollections
    match /users/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();

      // User's personal favorites
      match /favorites/{favoriteId} {
        allow read, write: if isOwner(userId);
      }

      // User's personal playlists
      match /personalPlaylists/{playlistId} {
        allow read, write: if isOwner(userId);
      }

      // User playback history
      match /playbackHistory/{historyId} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
